{
  "name": "wissfort",
  "version": "0.5.0",
  "description": "Librería de notificaciones toast minimalista, personalizable y bonita",
  "keywords": [
    "toast",
    "notification",
    "alert",
    "vanilla",
    "tailwind"
  ],
  "author": "EJCP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EJCP3/wiss.git"
  },
  "homepage": "https://wissfort.vercel.app",
  "type": "module",
  "types": "./dist/core/index.d.ts",
  "module": "./dist/core.es.js",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.es.js"
    },
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla.es.js"
    },
    "./island": {
      "types": "./dist/styles/island.d.ts",
      "import": "./dist/island.es.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.es.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue.es.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "import": "./dist/svelte.es.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/vanilla.es.js",
    "./dist/island.es.js",
    "./dist/styles/*"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/smoke.mjs && node test/pause.mjs && node test/update.mjs && node test/container.mjs && node test/sanitize.mjs && node test/hotconfig.mjs && node test/packaging.mjs",
    "playground": "vite --open /playground/sileo-test.html"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17",
    "svelte": ">=3",
    "tailwindcss": ">=3",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vite-plugin-dts": "^4.0.3",
    "vue": "^3.5.40"
  },
  "dependencies": {
    "cuelume": "^0.1.2"
  }
}

---
import type { Lang } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---
<!-- Hero Section -->
<section class="min-h-screen flex flex-col items-center justify-center relative pt-24 pb-12">
  <div class="text-center space-y-6 max-w-2xl px-4">
    <h1 class="text-6xl md:text-[5rem] font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
      wissfort<span class="text-zinc-300">.</span>
    </h1>
    <p class="text-zinc-500 text-lg leading-relaxed max-w-lg mx-auto">
      {t('hero.description')}
    </p>
    
    <div class="flex justify-center pt-2">
      <button class="copy-button group" onclick="navigator.clipboard.writeText('pnpm install wissfort')">
        <span class="text-zinc-400">$</span>
        <span>{t('hero.install_command')}</span>
        <svg class="w-4 h-4 text-zinc-400 group-hover:text-zinc-600 dark:text-zinc-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
      </button>
    </div>


  <!-- Playground Buttons (Try It) positioned at the bottom of the hero -->
  <div id="playground" class="absolute bottom-12 left-0 right-0 flex flex-col items-center gap-5">
    <span class="text-xs font-bold tracking-[0.2em] text-zinc-300 uppercase">{t('hero.try_it')}</span>
    <div class="flex flex-wrap justify-center gap-2 px-4">
      <button class="toast-btn">{t('hero.toast_buttons.success')}</button>
      <button class="toast-btn">{t('hero.toast_buttons.error')}</button>
      <button class="toast-btn">{t('hero.toast_buttons.warning')}</button>
      <button class="toast-btn">{t('hero.toast_buttons.info')}</button>
      <button class="toast-btn">{t('hero.toast_buttons.action')}</button>
      <button class="toast-btn">{t('hero.toast_buttons.promise')}</button>
    </div>
  </div>
</section>

<script>
  import { toast } from 'wissfort';

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('#playground .toast-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const type = (e.target as HTMLElement).textContent?.toLowerCase().trim();
        const i18n = (window as any).i18nToasts?.actions || {
          success: 'Event has been created',
          success_desc: 'Sunday, December 03, 2023 at 9:00 AM',
          error_missing_fields: 'Missing required fields',
          error_missing_fields_desc: 'Please fill in all required fields to continue.',
          warning_session: 'Your session will expire soon',
          warning_session_desc: 'Please save your work before you are logged out.',
          info_update: 'New software update available',
          info_update_desc: 'Version 2.0.1 is now available for download.',
          action_deleted: 'Item deleted',
          action_deleted_desc: 'The selected item has been permanently removed.',
          action_undo: 'Undo',
          action_undo_success: 'Action undone successfully',
          promise_loading: 'Loading data...',
          promise_success: 'Data loaded successfully!',
          promise_success_desc: 'The information has been synced with the server.',
          promise_error: 'Error loading data',
          promise_error_desc: 'There was a problem trying to connect to the server.'
        };
        
        switch(type) {
          case 'success': toast.success(i18n.success, { description: i18n.success_desc }); break;
          case 'error': toast.error(i18n.error_missing_fields, { description: i18n.error_missing_fields_desc }); break;
          case 'warning': toast.warning(i18n.warning_session, { description: i18n.warning_session_desc }); break;
          case 'info': toast.info(i18n.info_update, { description: i18n.info_update_desc }); break;
          case 'action': toast.show(i18n.action_deleted, { 
            description: i18n.action_deleted_desc,
            action: { label: i18n.action_undo, onClick: () => toast.success(i18n.action_undo_success || 'Action undone successfully') } 
          }); break;
          case 'promise': 
            toast.promise(new Promise(resolve => setTimeout(resolve, 2000)), {
              loading: i18n.promise_loading,
              success: i18n.promise_success,
              error: i18n.promise_error
            }); 
            break;
        }
      });
    });
  });
</script>

<script is:inline define:vars={{ interactiveToasts }}>
  window.i18nToasts = interactiveToasts;
</script>

<script>
  import { toast } from 'wissfort';
  import { toaster } from 'wissfort/vanilla';

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.icon-option').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const block = (e.currentTarget as HTMLElement).closest('.preview-block');
        if (!block) return;
        const codeEl = block.querySelector('[data-code-editor]');
        if (!codeEl) return;
        
        const newIcon = (e.currentTarget as HTMLElement).getAttribute('data-icon');
        let text = codeEl.textContent || '';
        text = text.replace(/icon:\s*(['"`])([\s\S]*?)\1/, `icon: $1${newIcon}$1`);
        codeEl.textContent = text;
        
        (block.querySelector('.run-code-btn') as HTMLElement)?.click();
      });
    });

    document.querySelectorAll('.toast-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const type = (e.target as HTMLElement).textContent?.toLowerCase().trim();
        const i18n = (window as any).i18nToasts?.actions || {};
        
        switch(type) {
          case 'success': 
          case 'error': 
          case 'warning': 
          case 'info': 
          case 'action': 
          case 'promise': 
            if (!(e.target as HTMLElement).closest('#playground')) {
               if (type === 'success') toast.success(i18n.success || 'Success');
               if (type === 'error') toast.error(i18n.error_missing_fields || 'Error');
               if (type === 'warning') toast.warning(i18n.warning_session || 'Warning');
               if (type === 'info') toast.info(i18n.info_update || 'Info');
               if (type === 'action') {
                 toast.show(i18n.action_deleted, { 
                   action: { label: i18n.action_undo, onClick: () => console.log('Undone') } 
                 });
               }
               if (type === 'promise') {
                 toast.promise(new Promise(resolve => setTimeout(resolve, 2000)), {
                   loading: i18n.promise_loading,
                   success: i18n.promise_success,
                   error: i18n.promise_error
                 });
               }
            }
            break;
          case 'description': toast.success(i18n.desc_title, { description: i18n.desc_text }); break;
          case 'icon': toast.info(i18n.icon_title, { icon: '🚀' }); break;
          case 'progress': toast.info(i18n.progress_title, { duration: 5000, progressBar: true }); break;
          case 'history': 
            console.log(toast.history()); 
            toast.info(i18n.history_logged); 
            break;
          case 'dark theme': toaster({ theme: 'dark' }); toast.success(i18n.theme_dark); break;
          case 'light theme': toaster({ theme: 'light' }); toast.success(i18n.theme_light); break;
          case 'classic format': toaster({ format: 'classic' }); toast.success(i18n.format_classic); break;
          case 'island format': toaster({ format: 'island' }); toast.success(i18n.format_island); break;
          case 'limit 2': toaster({ maxToasts: 2 }); toast.info(i18n.limit_2); break;
          case 'limit 5': toaster({ maxToasts: 5 }); toast.info(i18n.limit_5); break;
          case 'behavior normal': toaster({ replaceBehavior: 'normal' }); toast.info(i18n.behavior_normal); break;
          case 'behavior wiss': toaster({ replaceBehavior: 'wiss' }); toast.info(i18n.behavior_wiss); break;
        }
      });
    });

    document.querySelectorAll('.sound-demo-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const soundName = (e.currentTarget as HTMLElement).getAttribute('data-sound');
        const i18nSounds = (window as any).i18nToasts?.sounds || {};
        
        if (soundName) {
          toast.info(i18nSounds.prefix?.replace('{soundName}', soundName) || `Sound: ${soundName}`, { 
            sound: soundName,
            description: i18nSounds[soundName] || ''
          });
        }
      });
    });

    document.querySelectorAll(".run-code-btn").forEach(btn => {
      btn.addEventListener('click', (e) => {
        const block = (e.target as HTMLElement).closest('.preview-block');
        if (!block) return;
        const codeEl = block.querySelector('[data-code-editor]');
        if (!codeEl) return;
        
        let rawCode = codeEl.textContent || '';
        rawCode = rawCode.replace(/import\s+.*?;?\n/g, '');
        
        try {
          new Function('toast', 'toaster', rawCode)(toast, toaster);
        } catch(err) {
          const i18n = (window as any).i18nToasts?.actions || {};
          toast.error(i18n.syntax_error || 'Syntax Error');
          console.error(err);
        }
      });
    });
  });
</script>

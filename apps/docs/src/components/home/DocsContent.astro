---
import CodeBlock from '../CodeBlock.astro';
import PreviewBlock from '../PreviewBlock.astro';
import type { Lang } from '../../i18n/utils';
import { useTranslations, getTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const interactiveToasts = getTranslations(lang, 'interactive_toasts');
---
<article class="flex-1 max-w-2xl prose prose-zinc prose-a:text-zinc-900 dark:text-zinc-100 pb-32">
  <h2 id="introduccion" class="text-3xl font-bold text-zinc-900 dark:text-zinc-100 mb-6">{t('content.introduccion.title')}</h2>
  <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6">
    {t('content.introduccion.p1')}
  </p>
  <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6">
    {t('content.introduccion.p2')}
  </p>

  <h2 id="instalacion" class="text-2xl font-bold text-zinc-900 dark:text-zinc-100 mb-6 mt-12">{t('content.instalacion.title')}</h2>
  <CodeBlock lang="bash" code="pnpm add wissfort" />
  
  <h2 id="sonido-e-interacciones" class="text-2xl font-bold text-zinc-900 dark:text-zinc-100 mb-6 mt-12">{t('content.sonido_interacciones.title')}</h2>
  <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6" set:html={t('content.sonido_interacciones.p1_html')} />
  <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6">{t('content.sonido_interacciones.p2')}</p>
  <CodeBlock lang="js" code={`import { toaster } from 'wissfort';\n\ntoaster({ sound: false });`} />

  <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6 mt-6" set:html={t('content.sonido_interacciones.p3_html')} />
  <CodeBlock lang="js" code={`toast.info('Notificación con sonido especial', { sound: 'sparkle' });`} />

  <div class="mt-8 mb-6 p-6 border border-zinc-200 dark:border-zinc-800 rounded-xl bg-white dark:bg-[#121214]">
    <h3 class="font-bold text-zinc-900 dark:text-zinc-100 mb-2">{t('content.sonido_interacciones.default_sounds_title')}</h3>
    <p class="text-sm text-zinc-600 dark:text-zinc-400 mb-4" set:html={t('content.sonido_interacciones.default_sounds_desc_html')} />
    <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 text-sm text-zinc-600 dark:text-zinc-400">
      <li><strong>success:</strong> <code>success</code></li>
      <li><strong>error:</strong> <code>press</code></li>
      <li><strong>warning:</strong> <code>chime</code></li>
      <li><strong>info:</strong> <code>droplet</code></li>
      <li><strong>loading:</strong> <code>bloom</code></li>
    </ul>
  </div>

  <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 mb-4 mt-8">{t('content.sonido_interacciones.catalogo_title')}</h3>
  <p class="text-sm text-zinc-600 dark:text-zinc-400 mb-6">{t('content.sonido_interacciones.catalogo_desc')}</p>

  <PreviewBlock id="sound-catalog" lang="js" code={`import { toast } from 'wissfort';\n\n// Prueba cualquier sonido personalizado\ntoast.info('Chime sonando', { sound: 'chime' });\ntoast.info('Mensaje discreto', { sound: 'whisper' });\ntoast.info('Error mecánico', { sound: 'toggle' });`}>
    <div slot="preview" class="flex flex-wrap justify-center gap-2 px-4 max-w-2xl mx-auto">
      <button class="sound-demo-btn px-4 py-2 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-600 dark:text-zinc-300 transition-colors" data-sound="chime">chime</button>
      <button class="sound-demo-btn px-4 py-2 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-600 dark:text-zinc-300 transition-colors" data-sound="sparkle">sparkle</button>
      <button class="sound-demo-btn px-4 py-2 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-600 dark:text-zinc-300 transition-colors" data-sound="droplet">droplet</button>
      <button class="sound-demo-btn px-4 py-2 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-600 dark:text-zinc-300 transition-colors" data-sound="bloom">bloom</button>
      <button class="sound-demo-btn px-4 py-2 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-600 dark:text-zinc-300 transition-colors" data-sound="whisper">whisper</button>
      <button class="sound-demo-btn px-4 py-2 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-600 dark:text-zinc-300 transition-colors" data-sound="tick">tick</button>
      <button class="sound-demo-btn px-4 py-2 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-600 dark:text-zinc-300 transition-colors" data-sound="press">press</button>
      <button class="sound-demo-btn px-4 py-2 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-600 dark:text-zinc-300 transition-colors" data-sound="release">release</button>
      <button class="sound-demo-btn px-4 py-2 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-600 dark:text-zinc-300 transition-colors" data-sound="toggle">toggle</button>
      <button class="sound-demo-btn px-4 py-2 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-600 dark:text-zinc-300 transition-colors" data-sound="success">success</button>
      <button class="sound-demo-btn px-4 py-2 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-600 dark:text-zinc-300 transition-colors" data-sound="error">error</button>
      <button class="sound-demo-btn px-4 py-2 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-600 dark:text-zinc-300 transition-colors" data-sound="page">page</button>
      <button class="sound-demo-btn px-4 py-2 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-600 dark:text-zinc-300 transition-colors" data-sound="loading">loading</button>
      <button class="sound-demo-btn px-4 py-2 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-600 dark:text-zinc-300 transition-colors" data-sound="ready">ready</button>
    </div>
  </PreviewBlock>

  <h2 id="uso-basico" class="text-2xl font-bold text-zinc-900 dark:text-zinc-100 mb-6 mt-12">{t('content.uso_basico.title')}</h2>
  <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6" set:html={t('content.uso_basico.desc_html')} />
  
  <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 mb-4 mt-8">{t('content.uso_basico.simples_title')}</h3>
  <PreviewBlock id="toast-simple" lang="js" code={`import { toast } from 'wissfort';\n\ntoast.success('Usuario creado');\ntoast.error('Algo salió mal');\ntoast.warning('Revisa este campo');\ntoast.info('Nueva actualización disponible');`}>
    <div slot="preview" class="flex flex-wrap justify-center gap-3">
      <button class="toast-btn px-5 py-2.5 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300 transition-colors">Success</button>
      <button class="toast-btn px-5 py-2.5 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300 transition-colors">Error</button>
      <button class="toast-btn px-5 py-2.5 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300 transition-colors">Warning</button>
      <button class="toast-btn px-5 py-2.5 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300 transition-colors">Info</button>
    </div>
  </PreviewBlock>
  <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-4 text-center">{t('content.uso_basico.simples_tip')}</p>

  <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 mb-4 mt-8">{t('content.uso_basico.action_title')}</h3>
  <PreviewBlock id="toast-action" lang="js" code={`import { toast } from 'wissfort';\n\ntoast.show('Elemento eliminado', { \n  action: { \n    label: 'Deshacer', \n    onClick: () => console.log('Acción deshecha') \n  } \n});`}>
    <div slot="preview" class="flex justify-center">
      <button class="toast-btn px-5 py-2.5 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300 transition-colors">Action</button>
    </div>
  </PreviewBlock>

  <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 mb-4 mt-8">{t('content.uso_basico.promise_title')}</h3>
  <PreviewBlock id="toast-promise" lang="js" code={`import { toast } from 'wissfort';\n\ntoast.promise(\n  fetch('/api/users'),\n  {\n    loading: 'Cargando usuarios...',\n    success: 'Usuarios cargados correctamente',\n    error: 'Error al cargar usuarios',\n  }\n);`}>
    <div slot="preview" class="flex justify-center">
      <button class="toast-btn px-5 py-2.5 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300 transition-colors">Promise</button>
    </div>
  </PreviewBlock>

  <h2 id="opciones" class="text-2xl font-bold text-zinc-900 dark:text-zinc-100 mb-6 mt-12">{t('content.opciones.title')}</h2>
  <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6">{t('content.opciones.desc')}</p>

  <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 mb-4 mt-8">{t('content.opciones.desc_title')}</h3>
  <PreviewBlock id="toast-description" lang="js" code={`import { toast } from 'wissfort';\n\ntoast.success('¡Archivo guardado!', {\n  description: 'El archivo se guardó correctamente en tu carpeta local.'\n});`}>
    <div slot="preview" class="flex justify-center">
      <button class="toast-btn px-5 py-2.5 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300 transition-colors">Description</button>
    </div>
  </PreviewBlock>

  <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 mb-4 mt-8">{t('content.opciones.icon_title')}</h3>
  <PreviewBlock id="toast-icon" lang="js" code={`import { toast } from 'wissfort';\n\ntoast.info('Nueva actualización', {\n  icon: '🚀' // Puedes pasar un string, HTML o SVG\n});`}>
    <div slot="preview" class="flex flex-col items-center gap-4 w-full">
      <button class="run-code-btn px-6 py-2.5 bg-black text-white dark:bg-white dark:text-black hover:scale-105 rounded-xl text-sm font-medium transition-all shadow-lg">{t('content.opciones.icon_run_code')}</button>
      <div class="text-sm text-zinc-500 flex flex-col gap-2 items-center justify-center">
         <span>{t('content.opciones.icon_choose')}</span>
         <div class="flex gap-2">
           <button class="icon-option p-2 bg-zinc-100 dark:bg-zinc-800/50 rounded hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors text-xl" data-icon="💡">💡</button>
           <button class="icon-option p-2 bg-zinc-100 dark:bg-zinc-800/50 rounded hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors text-xl" data-icon="🔥">🔥</button>
           <button class="icon-option p-2 bg-zinc-100 dark:bg-zinc-800/50 rounded hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors text-xl" data-icon="✨">✨</button>
           <button class="icon-option p-2 bg-zinc-100 dark:bg-zinc-800/50 rounded hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors text-zinc-700 dark:text-zinc-300" data-icon='<svg width="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>'>
             <svg width="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
           </button>
           <button class="icon-option p-2 bg-zinc-100 dark:bg-zinc-800/50 rounded hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors text-green-500" data-icon='<svg width="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>'>
             <svg width="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
           </button>
         </div>
      </div>
    </div>
  </PreviewBlock>

  <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 mb-4 mt-8">{t('content.opciones.progress_title')}</h3>
  <PreviewBlock id="toast-progress" lang="js" code={`import { toast } from 'wissfort';\n\ntoast.info('Descargando archivo...', {\n  duration: 5000,\n  progressBar: true\n});`}>
    <div slot="preview" class="flex justify-center">
      <button class="toast-btn px-5 py-2.5 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300 transition-colors">Progress</button>
    </div>
  </PreviewBlock>

  <h2 id="historial" class="text-2xl font-bold text-zinc-900 dark:text-zinc-100 mb-6 mt-12">{t('content.historial.title')}</h2>
  <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6">{t('content.historial.desc')}</p>
  <PreviewBlock id="toast-history" lang="js" code={`import { toast } from 'wissfort';\n\nconst historial = toast.history();\nconsole.log(historial); // Array con los toasts anteriores\n\n// Para limpiar el historial:\n// toast.clearHistory();`}>
    <div slot="preview" class="flex justify-center">
      <button class="toast-btn px-5 py-2.5 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300 transition-colors">History</button>
    </div>
  </PreviewBlock>

  <h2 id="configuracion" class="text-2xl font-bold text-zinc-900 dark:text-zinc-100 mb-6 mt-12">{t('content.configuracion_global.title')}</h2>
  <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6" set:html={t('content.configuracion_global.desc_html')} />

  <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 mb-4 mt-8">{t('content.configuracion_global.tema_title')}</h3>
  <PreviewBlock id="toast-theme" lang="js" code={`import { toaster } from 'wissfort/vanilla';\n\n// Cambia globalmente el tema visual\ntoaster({ theme: 'dark' }); // 'light' | 'dark' | 'shadcn' | 'daisy'`}>
    <div slot="preview" class="flex justify-center gap-3">
      <button class="toast-btn px-5 py-2.5 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300 transition-colors">Dark Theme</button>
      <button class="toast-btn px-5 py-2.5 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300 transition-colors">Light Theme</button>
    </div>
  </PreviewBlock>

  <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 mb-4 mt-8">{t('content.configuracion_global.formato_title')}</h3>
  <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4">{t('content.configuracion_global.formato_desc')}</p>
  <PreviewBlock id="toast-format" lang="js" code={`import { toaster } from 'wissfort/vanilla';\n\n// classic: Bordes definidos\n// island: Diseño más suave e integrado\ntoaster({ format: 'island' });`}>
    <div slot="preview" class="flex justify-center gap-3">
      <button class="toast-btn px-5 py-2.5 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300 transition-colors">Classic Format</button>
      <button class="toast-btn px-5 py-2.5 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300 transition-colors">Island Format</button>
    </div>
  </PreviewBlock>

  <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 mb-4 mt-8">{t('content.configuracion_global.limite_title')}</h3>
  <PreviewBlock id="toast-limit" lang="js" code={`import { toaster } from 'wissfort/vanilla';\n\n// Máximo de toasts visibles al mismo tiempo\ntoaster({ maxToasts: 2 });`}>
    <div slot="preview" class="flex justify-center gap-3">
      <button class="toast-btn px-5 py-2.5 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300 transition-colors">Limit 2</button>
      <button class="toast-btn px-5 py-2.5 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300 transition-colors">Limit 5</button>
    </div>
  </PreviewBlock>

  <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 mb-4 mt-8">{t('content.configuracion_global.behavior_title')}</h3>
  <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4" set:html={t('content.configuracion_global.behavior_desc_html')} />
  <PreviewBlock id="toast-behavior" lang="js" code={`import { toaster } from 'wissfort/vanilla';\n\ntoaster({ replaceBehavior: 'wiss' }); // 'normal' | 'wiss'`}>
    <div slot="preview" class="flex justify-center gap-3">
      <button class="toast-btn px-5 py-2.5 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300 transition-colors">Behavior Normal</button>
      <button class="toast-btn px-5 py-2.5 bg-[#f6f6f7] hover:bg-[#ececed] dark:bg-zinc-800 dark:hover:bg-zinc-700 rounded-xl text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300 transition-colors">Behavior Wiss</button>
    </div>
  </PreviewBlock>

  <h2 id="uso-astro" class="text-2xl font-bold text-zinc-900 dark:text-zinc-100 mb-6 mt-12">{t('content.uso_astro.title')}</h2>
  <CodeBlock lang="astro" code={`---\n// Layout.astro\n---\n<slot />\n<script>\n  import { toaster } from 'wissfort/vanilla';\n  toaster();\n</script>`} />
  <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6">{t('content.uso_astro.desc')}</p>
  <CodeBlock lang="js" code={`import { toast } from 'wissfort';\ntoast.success('¡Listo!');`} />

  <h2 id="temas" class="text-2xl font-bold text-zinc-900 dark:text-zinc-100 mb-6 mt-12">{t('content.temas.title')}</h2>
  <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6">{t('content.temas.desc')}</p>
  
  <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 mb-4 mt-8">{t('content.temas.shadcn_title')}</h3>
  <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6" set:html={t('content.temas.shadcn_desc_html')} />
  <CodeBlock lang="js" code={`import { toaster } from 'wissfort/vanilla';\n\ntoaster({\n  theme: 'shadcn',\n  position: 'bottom-right',\n  duration: 4000,\n});`} />
  <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6 text-sm bg-zinc-50 dark:bg-zinc-800/50 p-4 rounded-xl" set:html={t('content.temas.shadcn_nota_html')} />

  <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 mb-4 mt-8">{t('content.temas.daisyui_title')}</h3>
  <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6" set:html={t('content.temas.daisyui_desc1_html')} />

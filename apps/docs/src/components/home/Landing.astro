---
import Layout from '../../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Hero from './Hero.astro';
import Sidebar from './Sidebar.astro';
import DocsContent from './DocsContent.astro';
import FabAgents from './FabAgents.astro';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Layout title="wissfort" lang={lang}>
  <Navbar lang={lang} />
  <Hero lang={lang} />

  <!-- Documentation Section -->
  <section id="docs" class="bg-[#f8faff] dark:bg-zinc-950 min-h-screen py-24 transition-colors duration-300">
    <div class="max-w-6xl mx-auto px-4 md:px-8 flex gap-16 relative">
      <Sidebar lang={lang} />
      <DocsContent lang={lang} />
    </div>
  </section>

  <FabAgents lang={lang} />

  <script>
    import { toaster } from 'wissfort/vanilla';
    import { docsToasterState } from '../../scripts/toaster-state';

    // Runs on every navigation, not just the first load: with
    // <ViewTransitions /> the <body> is replaced, so the toaster container
    // goes with it. Re-applying the config here also keeps the format/theme
    // chosen in the navbar from resetting when you switch language.
    document.addEventListener('astro:page-load', () => {
      const isDark = document.documentElement.classList.contains('dark');
      docsToasterState.theme = isDark ? 'dark' : 'light';
      toaster({
        format: docsToasterState.format,
        position: 'top-center',
        theme: docsToasterState.theme,
      });
    });
  </script>
</Layout>
